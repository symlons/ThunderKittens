digraph OutputProjectionFusion {
  graph [
    rankdir=LR,
    bgcolor="white",
    label="Output Projection Fusion Boundary: TK Custom vs torch.compile-visible Epilogue",
    labelloc=t,
    fontsize=22,
    fontname="Helvetica",
    pad=0.35,
    nodesep=0.42,
    ranksep=0.70
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.10,0.08", color="#3b4252"];
  edge [fontname="Helvetica", fontsize=10, color="#4c566a", arrowsize=0.8];

  subgraph cluster_legend {
    label="Legend";
    fontsize=13;
    color="#d8dee9";
    style="rounded";
    l_gemm [label="GEMM / matmul", fillcolor="#c7e9b4"];
    l_torch [label="torch.compile fused Triton pointwise", fillcolor="#bbdefb"];
    l_tk [label="TK custom fused kernel", fillcolor="#ffd59e"];
    l_saved [label="Saved tensor for backward", fillcolor="#e1bee7"];
    l_spill [label="Register spill observed", fillcolor="#ffcdd2", color="#b71c1c", penwidth=2];
  }

  subgraph cluster_torch {
    label="Epilogue-visible path: compile_fused_output_proj_epilogue";
    color="#90caf9";
    penwidth=2;
    style="rounded";

    t_in [label="input activation\nh / attn_out", fillcolor="#eceff1"];
    t_linear [label="torch.nn.functional.linear\ncuBLAS / NVJET output projection", fillcolor="#c7e9b4", penwidth=2];
    t_projected [label="projected output\nvisible graph value", fillcolor="#e1bee7"];
    t_gate [label="gate broadcast / mul / add\nTriton or small TK pointwise", fillcolor="#bbdefb", penwidth=2];
    t_out [label="residual output", fillcolor="#eceff1"];
    t_bwd_gate [label="gate/residual backward\nsmall fused pointwise reductions", fillcolor="#bbdefb"];
    t_dw [label="dW / dX matmuls\ncuBLAS / NVJET", fillcolor="#c7e9b4"];

    t_in -> t_linear -> t_projected -> t_gate -> t_out;
    t_projected -> t_bwd_gate [label="saved for backward"];
    t_bwd_gate -> t_dw;
  }

  subgraph cluster_tk {
    label="Current TK fused path: compile_fused_output_proj";
    color="#ffcc80";
    penwidth=2;
    style="rounded";

    k_in [label="input activation\nh / attn_out", fillcolor="#eceff1"];
    k_fused [label="tk_dit::gemm_linear_gated_residual\nGEMM + bias + store projected + gate*projected + residual", fillcolor="#ffcdd2", color="#b71c1c", penwidth=3];
    k_projected [label="projected output\nsaved for backward", fillcolor="#e1bee7"];
    k_out [label="residual output", fillcolor="#eceff1"];
    k_bwd_gate [label="gated_residual_backward\nTK pointwise/reduction", fillcolor="#ffd59e"];
    k_dw [label="dW / dX matmuls", fillcolor="#c7e9b4"];

    k_in -> k_fused -> k_out;
    k_fused -> k_projected [label="also writes"];
    k_projected -> k_bwd_gate;
    k_bwd_gate -> k_dw;
  }

  subgraph cluster_findings {
    label="Measured Finding";
    color="#d8dee9";
    style="rounded,filled";
    fillcolor="#fafafa";
    finding [shape=note, label="Custom projected gated GEMM appears as hot TK kernel:\n~1.514 ms over 72 calls in short profiler run.\nptxas reports 24-28 B spills for gated_linear_template.\nEpilogue-visible path removes that kernel and lets cuBLAS/NVJET own GEMM.", fillcolor="#fff9c4", color="#f9a825"];
  }

  t_linear -> finding [style=dashed, arrowhead=none];
  k_fused -> finding [style=dashed, arrowhead=none];
}
